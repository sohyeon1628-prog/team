# Local UI review: demo. Core integration / production: api.
VITE_DATA_MAP_MODE=demo
# Real workspace ID must come from App Core session/article context in integration.
VITE_WORKSPACE_ID=
# Empty uses same-origin /v1 (Vite forwards to localhost:3001 in development).
VITE_CORE_BASE_URL=

